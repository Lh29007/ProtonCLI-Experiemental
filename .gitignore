# Proton runtimes and prefixes (created under ~/.local/share/proton-cli)
runtimes/
prefixes/
proton/
proton-runtimes/
compatdata/
prefix/

# Downloads and archives
cache/
downloads/
*.tar.gz
*.tar.xz
*.zip
*.7z
*.sha512sum

# Logs
logs/
*.log
*.log.status

# Local configuration
config/
*.local
.env
.env.*

# Games and game files (never commit them)
games/
*.exe
*.msi

# Temporary files
tmp/
temp/
*.tmp
*.cache

# Python
__pycache__/
*.py[cod]
.venv/
venv/

# Build output
build/
dist/

# Editors and OS files
.vscode/
.idea/
.DS_Store
Thumbs.db

# Backups
*~
*.bak

# Secrets
*.key
*.pem
credentials*
