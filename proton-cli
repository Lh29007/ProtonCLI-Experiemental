#!/bin/sh

set -eu

VERSION="0.6.0-exp"

if [ -n "${SUDO_USER:-}" ] && [ "$SUDO_USER" != "root" ]; then
    REAL_USER="$SUDO_USER"
    REAL_HOME="$(getent passwd "$REAL_USER" | cut -d: -f6)"
else
    REAL_USER="$(id -un)"
    REAL_HOME="$HOME"
fi

if [ -z "$REAL_HOME" ]; then
    echo "proton-cli: unable to determine HOME."
    exit 1
fi

BASE="$REAL_HOME/.local/share/proton-cli"
CONFIG="$REAL_HOME/.config/proton-cli"

RUNTIMES="$BASE/runtimes"
PREFIXES="$BASE/prefixes"
GAMES="$BASE/games"
CACHE="$BASE/cache"
LOGS="$BASE/logs"

GE_API="${PROTON_GE_API:-https://api.github.com/repos/GloriousEggroll/proton-ge-custom/releases/latest}"
DD_API="${PROTON_DROIDDECK_API:-https://api.github.com/repos/Droid-Deck/DroidDeck-Proton/releases/latest}"

die()
{
    echo ""
    echo "proton-cli: $*" >&2
    exit 1
}

require()
{
    if ! command -v "$1" >/dev/null 2>&1; then
        die "Required command not found: $1"
    fi
}

usage()
{
    echo "Proton-CLI $VERSION"
    echo ""
    echo "Usage:"
    echo ""
    echo "  proton-cli install [auto|ge|droiddeck]"
    echo "      Install a Proton runtime and make it the default."
    echo "      auto       (default) arm64 -> DroidDeck-Proton, x86_64 -> GE-Proton"
    echo "      ge         GE-Proton (x86_64 only)"
    echo "      droiddeck  DroidDeck-Proton (arm64 only)"
    echo "      PROTON_RUNTIME_URL=<archive.tar.gz> installs a specific archive"
    echo "      instead of either source."
    echo ""
    echo "  proton-cli use <runtime>"
    echo "      Choose the runtime used by 'run' (see: proton-cli list)"
    echo ""
    echo "  proton-cli update [auto|ge|droiddeck]"
    echo "      Install the latest build from a source"
    echo ""
    echo "  proton-cli list"
    echo "      List installed runtimes and prefixes"
    echo ""
    echo "  proton-cli remove <runtime>"
    echo "      Remove a runtime"
    echo ""
    echo "  proton-cli run <game.exe> [arguments]"
    echo "      Run a Windows program with the default runtime"
    echo ""
    echo "  proton-cli prefix <name>"
    echo "      Create a Proton prefix"
    echo ""
    echo "  proton-cli doctor"
    echo "      Check the system"
    echo ""
    echo "  proton-cli version"
    echo "      Display the version"
    echo ""
    echo "  proton-cli uninstall"
    echo "      Remove Proton-CLI completely"
    echo ""
    echo "Environment:"
    echo "      PROTON_WRAPPER=<cmd>  launch Proton through <cmd> (e.g. FEX-Emu, box64)"
}

init_dirs()
{
    mkdir -p "$RUNTIMES"
    mkdir -p "$PREFIXES"
    mkdir -p "$GAMES"
    mkdir -p "$CACHE"
    mkdir -p "$LOGS"
    mkdir -p "$CONFIG"
}

detect_arch()
{
    ARCH="$(uname -m)"

    case "$ARCH" in
        x86_64|amd64)
            echo "x86_64"
            ;;
        aarch64|arm64)
            echo "aarch64"
            ;;
        *)
            die "Unsupported architecture: $ARCH"
            ;;
    esac
}

default_runtime_name()
{
    if [ -f "$CONFIG/runtime" ]; then
        head -n 1 "$CONFIG/runtime"
    fi
}

set_default_runtime()
{
    init_dirs
    printf '%s\n' "$1" > "$CONFIG/runtime"
}

find_runtime()
{
    DEFAULT_NAME="$(default_runtime_name)"

    if [ -n "$DEFAULT_NAME" ] && [ -f "$RUNTIMES/$DEFAULT_NAME/proton" ]; then
        printf '%s\n' "$RUNTIMES/$DEFAULT_NAME"
        return 0
    fi

    for runtime in "$RUNTIMES"/*
    do
        if [ -f "$runtime/proton" ]; then
            printf '%s\n' "$runtime"
            return 0
        fi
    done

    return 1
}

# Download a GitHub API response to a file, or stop with an error.
fetch_release_json()
{
    if ! curl \
        --fail \
        --location \
        --show-error \
        --silent \
        --retry 3 \
        --connect-timeout 15 \
        --output "$2" \
        "$1"
    then
        rm -f "$2"
        die "Unable to contact GitHub ($1)."
    fi

    if [ ! -s "$2" ]; then
        rm -f "$2"
        die "GitHub returned an empty response."
    fi
}

# Print the tag_name of a release JSON file.
release_tag()
{
    sed -n \
        's/.*"tag_name":[[:space:]]*"\([^"]*\)".*/\1/p' \
        "$1" |
    head -n 1 || true
}

# Print the first download URL of a release JSON file matching a regex.
release_asset()
{
    grep -o '"browser_download_url":[[:space:]]*"[^"]*"' "$1" |
    sed 's/.*"\(http[^"]*\)"$/\1/' |
    grep -Ei "$2" |
    head -n 1 || true
}

install_ge()
{
    require curl
    require tar
    require gzip
    require grep
    require sed
    require head
    require basename
    require mkdir
    require rm
    require uname
    require chmod
    require find

    init_dirs

    ARCH_NAME="$(detect_arch)"
    SOURCE="${1:-auto}"

    echo ""
    echo "======================================"
    echo " Proton-CLI Runtime Installer"
    echo "======================================"
    echo ""
    echo "[+] Architecture : $ARCH_NAME"

    URL=""
    TAG=""
    SHA_URL=""

    if [ -n "${PROTON_RUNTIME_URL:-}" ]; then
        # Explicit archive. Skips the source lookup; the architecture is
        # still checked after extraction.
        URL="$PROTON_RUNTIME_URL"
        TAG="custom"

        echo "[+] Using PROTON_RUNTIME_URL override:"
        echo "    $URL"
        echo ""
    else
        if [ "$SOURCE" = "auto" ]; then
            if [ "$ARCH_NAME" = "aarch64" ]; then
                SOURCE="droiddeck"
            else
                SOURCE="ge"
            fi
        fi

        case "$SOURCE" in
            ge)
                if [ "$ARCH_NAME" = "aarch64" ]; then
                    die "GE-Proton has no arm64 build. Use: proton-cli install droiddeck"
                fi
                ;;
            droiddeck)
                if [ "$ARCH_NAME" != "aarch64" ]; then
                    die "DroidDeck-Proton is arm64 only. Use: proton-cli install ge"
                fi
                ;;
            *)
                die "Unknown source: $SOURCE (use auto, ge or droiddeck)"
                ;;
        esac

        echo "[+] Source       : $SOURCE"
        echo ""
        echo "[+] Contacting GitHub..."

        if [ "$SOURCE" = "droiddeck" ]; then
            JSON="$CACHE/droiddeck.json"
            fetch_release_json "$DD_API" "$JSON"

            TAG="$(release_tag "$JSON")"
            [ -n "$TAG" ] || die "Unable to determine the latest DroidDeck-Proton version."

            URL="$(release_asset "$JSON" 'aarch64\.tar\.gz$')"
            SHA_URL="$(release_asset "$JSON" 'aarch64\.sha512sum$')"

            [ -n "$URL" ] || die "No DroidDeck-Proton arm64 archive in release $TAG."
        else
            JSON="$CACHE/ge-proton.json"
            fetch_release_json "$GE_API" "$JSON"

            TAG="$(release_tag "$JSON")"
            [ -n "$TAG" ] || die "Unable to determine the latest GE-Proton version."

            URL="$(release_asset "$JSON" 'GE-Proton.*(x86_64|amd64).*\.tar\.gz$')"

            [ -n "$URL" ] || die "No GE-Proton x86_64 archive in release $TAG."
        fi

        echo "[+] Latest version : $TAG"
        echo ""
    fi

    if [ -z "$URL" ]; then
        die "No Proton archive URL available for $ARCH_NAME."
    fi

    FILE="$(basename "$URL")"
    NAME="${FILE%.tar.gz}"

    ARCHIVE="$CACHE/$FILE"
    DEST="$RUNTIMES/$NAME"

    echo "[+] Archive     : $FILE"
    echo "[+] Destination : $DEST"
    echo ""

    case "$ARCH_NAME:$FILE" in
        x86_64:*aarch64*|x86_64:*arm64*)
            die "An ARM archive was selected for x86_64."
            ;;
        aarch64:*x86_64*|aarch64:*amd64*)
            die "An x86_64 archive was selected for aarch64."
            ;;
    esac

    if [ -f "$ARCHIVE" ] && [ -s "$ARCHIVE" ]; then
        echo "[+] Archive already downloaded."
    else
        echo "[+] Downloading..."
        echo ""

        rm -f "$ARCHIVE"

        if ! curl \
            --fail \
            --location \
            --show-error \
            --silent \
            --retry 3 \
            --connect-timeout 15 \
            --output "$ARCHIVE" \
            "$URL"
        then
            rm -f "$ARCHIVE"
            die "Download failed."
        fi
    fi

    if [ ! -s "$ARCHIVE" ]; then
        rm -f "$ARCHIVE"
        die "Downloaded archive is empty."
    fi

    if [ -n "$SHA_URL" ]; then
        if command -v sha512sum >/dev/null 2>&1; then
            SHA_FILE="$CACHE/$FILE.sha512sum"

            echo "[+] Downloading checksum..."

            if ! curl \
                --fail \
                --location \
                --show-error \
                --silent \
                --retry 3 \
                --connect-timeout 15 \
                --output "$SHA_FILE" \
                "$SHA_URL"
            then
                rm -f "$SHA_FILE"
                die "Checksum download failed."
            fi

            echo "[+] Verifying checksum..."

            if ! (cd "$CACHE" && sha512sum -c "$FILE.sha512sum" >/dev/null 2>&1); then
                rm -f "$ARCHIVE" "$SHA_FILE"
                die "Checksum mismatch. The archive was removed; run install again."
            fi

            echo "[OK] Checksum matches."
        else
            echo "[!] sha512sum not found: checksum not verified."
        fi
    fi

    echo ""
    echo "[+] Verifying archive..."

    if ! tar -tzf "$ARCHIVE" >/dev/null 2>&1; then
        rm -f "$ARCHIVE"
        die "Downloaded archive is invalid."
    fi

    echo "[OK] Archive is valid."

    echo "[+] Extracting..."

    rm -rf "$DEST"
    mkdir -p "$DEST"

    if ! tar \
        -xzf "$ARCHIVE" \
        -C "$DEST" \
        --strip-components=1
    then
        rm -rf "$DEST"
        die "Extraction failed."
    fi

    if [ ! -f "$DEST/proton" ]; then
        rm -rf "$DEST"
        die "Proton executable not found."
    fi

    WINE="$DEST/files/bin/wine"

    if [ ! -f "$WINE" ]; then
        rm -rf "$DEST"
        die "Wine executable not found."
    fi

    if command -v file >/dev/null 2>&1; then
        WINE_INFO="$(file "$WINE")"

        echo "[+] Wine binary:"
        echo "    $WINE_INFO"
        echo ""

        if [ "$ARCH_NAME" = "x86_64" ]; then
            if ! echo "$WINE_INFO" | grep -qi "x86-64"; then
                rm -rf "$DEST"
                die "Wine binary is not compatible with x86_64."
            fi
        fi

        if [ "$ARCH_NAME" = "aarch64" ]; then
            if ! echo "$WINE_INFO" | grep -qi "ARM aarch64"; then
                rm -rf "$DEST"
                die "Wine binary is not compatible with aarch64."
            fi
        fi

        echo "[OK] Wine architecture matches $ARCH_NAME."
    fi

    chmod +x "$DEST/proton"
    chmod +x "$WINE"

    set_default_runtime "$NAME"

    echo ""
    echo "======================================"
    echo "       Proton runtime installed!"
    echo "======================================"
    echo ""
    echo "Version      : $TAG"
    echo "Architecture : $ARCH_NAME"
    echo "Runtime      : $NAME (default)"
    echo "Path         : $DEST"
    echo ""
}

update_ge()
{
    install_ge "${1:-auto}"
}

use_runtime()
{
    NAME="${1:-}"

    if [ -z "$NAME" ]; then
        die "Usage: proton-cli use <runtime>"
    fi

    case "$NAME" in
        *..*|/*)
            die "Invalid runtime name."
            ;;
    esac

    if [ ! -f "$RUNTIMES/$NAME/proton" ]; then
        die "Runtime not found: $NAME (see: proton-cli list)"
    fi

    set_default_runtime "$NAME"

    echo ""
    echo "[OK] Default runtime: $NAME"
    echo ""
}

remove_runtime()
{
    NAME="${1:-}"

    if [ -z "$NAME" ]; then
        die "Usage: proton-cli remove <runtime>"
    fi

    case "$NAME" in
        *..*|/*)
            die "Invalid runtime name."
            ;;
    esac

    TARGET="$RUNTIMES/$NAME"

    if [ ! -d "$TARGET" ]; then
        die "Runtime not found: $NAME"
    fi

    echo ""
    echo "[+] Removing: $NAME"

    rm -rf "$TARGET"

    if [ "$(default_runtime_name)" = "$NAME" ]; then
        rm -f "$CONFIG/runtime"
        echo "[+] It was the default runtime; no default is set now."
    fi

    echo "[OK] Runtime removed."
}

create_prefix()
{
    NAME="${1:-}"

    if [ -z "$NAME" ]; then
        die "Usage: proton-cli prefix <name>"
    fi

    case "$NAME" in
        *..*|/*)
            die "Invalid prefix name."
            ;;
    esac

    PREFIX="$PREFIXES/$NAME"

    if [ -d "$PREFIX" ]; then
        echo "[+] Prefix already exists: $NAME"
        echo "    $PREFIX"
        return 0
    fi

    mkdir -p "$PREFIX"
    mkdir -p "$PREFIX/pfx"

    echo ""
    echo "======================================"
    echo " Prefix created"
    echo "======================================"
    echo ""
    echo "Name : $NAME"
    echo "Path : $PREFIX"
    echo ""
}

run_game()
{
    if [ "$#" -lt 1 ]; then
        die "Usage: proton-cli run <game.exe> [arguments]"
    fi

    GAME="$1"
    shift

    if [ ! -f "$GAME" ]; then
        die "File not found: $GAME"
    fi

    RUNTIME="$(find_runtime || true)"

    if [ -z "$RUNTIME" ]; then
        die "No Proton runtime installed. Run: proton-cli install"
    fi

    if [ "$(detect_arch)" = "aarch64" ] && [ -z "${PROTON_WRAPPER:-}" ]; then
        case "$(basename "$RUNTIME")" in
            *x86_64*|*x64*|*amd64*)
                echo "[!] x86_64 runtime on arm64 without PROTON_WRAPPER: it will likely fail."
                echo ""
                ;;
        esac
    fi

    if command -v realpath >/dev/null 2>&1; then
        GAME="$(realpath "$GAME")"
    else
        GAME="$(cd "$(dirname "$GAME")" && pwd)/$(basename "$GAME")"
    fi

    GAME_NAME="$(basename "$GAME")"
    GAME_NAME="${GAME_NAME%.*}"

    PREFIX="$PREFIXES/$GAME_NAME"

    mkdir -p "$PREFIX"
    mkdir -p "$PREFIX/pfx"
    mkdir -p "$LOGS"

    export STEAM_COMPAT_DATA_PATH="$PREFIX"
    export STEAM_COMPAT_CLIENT_INSTALL_PATH="$BASE"
    export WINEPREFIX="$PREFIX/pfx"

    LOG="$LOGS/$GAME_NAME.log"

    echo ""
    echo "======================================"
    echo " Proton-CLI"
    echo "======================================"
    echo ""
    echo "Runtime : $(basename "$RUNTIME")"
    echo "Game    : $GAME"
    echo "Prefix  : $PREFIX"
    echo "Log     : $LOG"
    echo ""

    cd "$(dirname "$GAME")"

    set +e
    if [ -n "${PROTON_WRAPPER:-}" ]; then
        # Optional launcher placed in front of Proton, e.g. an x86 emulator
        # such as FEX-Emu or box64 when running an x86_64 runtime on arm64.
        # shellcheck disable=SC2086
        $PROTON_WRAPPER "$RUNTIME/proton" run "$GAME" "$@" >"$LOG" 2>&1
    else
        "$RUNTIME/proton" run "$GAME" "$@" >"$LOG" 2>&1
    fi
    STATUS=$?
    set -e

    cat "$LOG"

    echo ""

    if [ "$STATUS" -eq 0 ]; then
        echo "[OK] Program finished successfully."
    else
        echo "[ERROR] Proton exited with status $STATUS."
        echo "[+] Full log: $LOG"
        return "$STATUS"
    fi
}

list_all()
{
    init_dirs

    DEFAULT_NAME="$(default_runtime_name)"

    echo ""
    echo "======================================"
    echo " Proton-CLI"
    echo "======================================"
    echo ""

    echo "Data:"
    echo "  $BASE"
    echo ""

    echo "Runtimes:"
    echo ""

    FOUND=0

    for runtime in "$RUNTIMES"/*
    do
        if [ -f "$runtime/proton" ]; then
            RNAME="$(basename "$runtime")"
            MARK=""
            if [ "$RNAME" = "$DEFAULT_NAME" ]; then
                MARK=" (default)"
            fi
            echo "  [OK] $RNAME$MARK"
            FOUND=1
        fi
    done

    if [ "$FOUND" -eq 0 ]; then
        echo "  No runtime installed"
    fi

    echo ""
    echo "Prefixes:"
    echo ""

    FOUND=0

    for prefix in "$PREFIXES"/*
    do
        if [ -d "$prefix" ]; then
            echo "  [OK] $(basename "$prefix")"
            FOUND=1
        fi
    done

    if [ "$FOUND" -eq 0 ]; then
        echo "  No prefixes"
    fi

    echo ""
}

doctor()
{
    init_dirs

    ARCH_NAME="$(detect_arch)"

    echo ""
    echo "======================================"
    echo " Proton-CLI Doctor"
    echo "======================================"
    echo ""

    echo "Version      : $VERSION"
    echo "User         : $REAL_USER"
    echo "HOME         : $REAL_HOME"
    echo "Architecture : $ARCH_NAME"
    echo ""

    echo "Directories:"
    echo ""
    echo "  Data     : $BASE"
    echo "  Config   : $CONFIG"
    echo "  Cache    : $CACHE"
    echo "  Logs     : $LOGS"
    echo "  Prefixes : $PREFIXES"
    echo "  Runtimes : $RUNTIMES"

    echo ""
    echo "Commands:"
    echo ""

    for command in curl tar gzip file git sha512sum
    do
        if command -v "$command" >/dev/null 2>&1; then
            echo "  [OK] $command"
        else
            echo "  [ABSENT] $command"
        fi
    done

    echo ""
    echo "Runtime:"
    echo ""

    if RUNTIME="$(find_runtime 2>/dev/null)"; then
        echo "  [OK] $(basename "$RUNTIME")"
    else
        echo "  [ABSENT] No runtime"
    fi

    echo "  Default  : $(default_runtime_name || true)"

    echo ""
    echo "Overrides:"
    echo ""
    echo "  PROTON_RUNTIME_URL : ${PROTON_RUNTIME_URL:-<unset, source lookup>}"
    echo "  PROTON_WRAPPER     : ${PROTON_WRAPPER:-<unset>}"

    if [ "$ARCH_NAME" = "aarch64" ]; then
        echo ""
        echo "Note: arm64 host. 'install' uses DroidDeck-Proton by default."
        echo "An x86_64 runtime also needs PROTON_WRAPPER (FEX-Emu or box64)."
        echo "The arm64 path is experimental and untested on real hardware."
    fi

    echo ""
}

version()
{
    echo "proton-cli $VERSION"
}

uninstall()
{
    if [ "$(id -u)" -ne 0 ]; then
        echo ""
        echo "[+] Administrator privileges are required."
        echo "[+] Restarting with sudo..."
        echo ""

        exec sudo "$0" uninstall
    fi

    echo ""
    echo "======================================"
    echo " Proton-CLI Uninstaller"
    echo "======================================"
    echo ""

    echo "[+] User          : $REAL_USER"
    echo "[+] Data          : $BASE"
    echo "[+] Configuration : $CONFIG"
    echo ""

    echo "[+] Removing Proton-CLI data..."

    rm -rf "$BASE"
    rm -rf "$CONFIG"

    echo "[OK] Data removed."

    echo "[+] Removing command..."

    rm -f "/usr/local/bin/proton-cli"

    echo "[OK] /usr/local/bin/proton-cli removed."

    echo ""
    echo "======================================"
    echo " Proton-CLI uninstalled"
    echo "======================================"
    echo ""
    echo "Steam Proton installations were not removed."
    echo "Your Steam games were not removed."
    echo ""
}

COMMAND="${1:-help}"

case "$COMMAND" in
    install)
        shift
        install_ge "$@"
        ;;

    update)
        shift
        update_ge "$@"
        ;;

    use)
        shift
        use_runtime "$@"
        ;;

    remove)
        shift
        remove_runtime "$@"
        ;;

    run)
        shift
        run_game "$@"
        ;;

    prefix)
        shift
        create_prefix "$@"
        ;;

    list)
        list_all
        ;;

    doctor)
        doctor
        ;;

    version|--version|-v)
        version
        ;;

    uninstall)
        uninstall
        ;;

    help|--help|-h)
        usage
        ;;

    *)
        echo "Unknown command: $COMMAND"
        echo ""
        usage
        exit 1
        ;;
esac
