#!/bin/sh
# Proton-CLI: run Windows programs with Proton from the command line.
# https://github.com/Lh29007/ProtonCLI-Experiemental

set -eu

VERSION="0.7.0-exp"

if [ -n "${SUDO_USER:-}" ] && [ "$SUDO_USER" != "root" ]; then
    REAL_USER="$SUDO_USER"
    REAL_HOME="$(getent passwd "$REAL_USER" | cut -d: -f6)"
else
    REAL_USER="$(id -un)"
    REAL_HOME="$HOME"
fi

if [ -z "$REAL_HOME" ]; then
    echo "proton-cli: unable to determine HOME." >&2
    exit 1
fi

BASE="$REAL_HOME/.local/share/proton-cli"
CONFIG="$REAL_HOME/.config/proton-cli"

RUNTIMES="$BASE/runtimes"
PREFIXES="$BASE/prefixes"
CACHE="$BASE/cache"
LOGS="$BASE/logs"

GAME_CONF="$CONFIG/games"
DEFAULT_FILE="$CONFIG/runtime"

GE_API="${PROTON_GE_API:-https://api.github.com/repos/GloriousEggroll/proton-ge-custom/releases/latest}"
DD_API="${PROTON_DROIDDECK_API:-https://api.github.com/repos/Droid-Deck/DroidDeck-Proton/releases/latest}"

die()
{
    printf 'proton-cli: %s\n' "$*" >&2
    exit 1
}

warn()
{
    printf '[!] %s\n' "$*"
}

require()
{
    if ! command -v "$1" >/dev/null 2>&1; then
        die "Required command not found: $1"
    fi
}

usage()
{
    echo "Proton-CLI $VERSION"
    echo ""
    echo "Usage:"
    echo ""
    echo "  proton-cli install [auto|ge|droiddeck]"
    echo "      Install the latest Proton runtime and make it the default."
    echo "      auto       (default) aarch64 -> DroidDeck-Proton, x86_64 -> GE-Proton"
    echo "      ge         GE-Proton (x86_64 only)"
    echo "      droiddeck  DroidDeck-Proton (aarch64 only)"
    echo "      PROTON_RUNTIME_URL=<archive.tar.gz> installs a specific archive."
    echo ""
    echo "  proton-cli update [auto|ge|droiddeck]"
    echo "      Same as install; does nothing if the latest release is installed."
    echo ""
    echo "  proton-cli use <runtime>"
    echo "      Set the default runtime used by 'run'"
    echo ""
    echo "  proton-cli list"
    echo "      List runtimes (default marked), prefixes and per-game settings"
    echo ""
    echo "  proton-cli remove <runtime>"
    echo "      Remove a runtime"
    echo ""
    echo "  proton-cli run <game.exe> [arguments]"
    echo "      Run a Windows program. Output is shown live and saved to a log."
    echo ""
    echo "  proton-cli config <game.exe> show"
    echo "  proton-cli config <game.exe> runtime <name|default>"
    echo "  proton-cli config <game.exe> wrapper <command|none>"
    echo "      Per-game settings"
    echo ""
    echo "  proton-cli prefix <name>"
    echo "      Create a standalone Proton prefix"
    echo ""
    echo "  proton-cli reset <game.exe> [--yes]"
    echo "      Delete the game's prefix so it is recreated on next run"
    echo ""
    echo "  proton-cli winetricks <game.exe> <verb>..."
    echo "      Run winetricks inside the game's prefix (needs winetricks installed)"
    echo ""
    echo "  proton-cli doctor"
    echo "      Check the system"
    echo ""
    echo "  proton-cli version"
    echo "  proton-cli uninstall"
    echo ""
    echo "Environment:"
    echo "  PROTON_WRAPPER=<cmd>   launch Proton through <cmd> (e.g. FEX-Emu, box64)"
    echo "  GITHUB_TOKEN=<token>   authenticate GitHub API requests (higher rate limit)"
}

init_dirs()
{
    mkdir -p "$RUNTIMES" "$PREFIXES" "$CACHE" "$LOGS" "$CONFIG" "$GAME_CONF"
}

detect_arch()
{
    ARCH="$(uname -m)"

    case "$ARCH" in
        x86_64|amd64)
            echo "x86_64"
            ;;
        aarch64|arm64)
            echo "aarch64"
            ;;
        *)
            die "Unsupported architecture: $ARCH"
            ;;
    esac
}

check_name()
{
    case "$1" in
        ""|*/*|*..*)
            die "Invalid name: '$1'"
            ;;
    esac
}

default_runtime_name()
{
    if [ -f "$DEFAULT_FILE" ]; then
        head -n 1 "$DEFAULT_FILE"
    fi
    return 0
}

set_default_runtime()
{
    init_dirs
    printf '%s\n' "$1" > "$DEFAULT_FILE"
}

tag_of()
{
    head -n 1 "$1/.proton-cli-tag" 2>/dev/null || true
}

# Print the runtime directory to use: the wanted one if given, otherwise
# the default, otherwise the first installed runtime.
resolve_runtime()
{
    if [ -n "$1" ]; then
        check_name "$1"
        if [ ! -f "$RUNTIMES/$1/proton" ]; then
            die "Runtime not found: $1 (see: proton-cli list)"
        fi
        printf '%s\n' "$RUNTIMES/$1"
        return 0
    fi

    DEFAULT_NAME="$(default_runtime_name)"

    if [ -n "$DEFAULT_NAME" ] && [ -f "$RUNTIMES/$DEFAULT_NAME/proton" ]; then
        printf '%s\n' "$RUNTIMES/$DEFAULT_NAME"
        return 0
    fi

    for runtime in "$RUNTIMES"/*
    do
        if [ -f "$runtime/proton" ]; then
            printf '%s\n' "$runtime"
            return 0
        fi
    done

    die "No Proton runtime installed. Run: proton-cli install"
}

abspath()
{
    if command -v realpath >/dev/null 2>&1; then
        realpath "$1"
    else
        (cd "$(dirname "$1")" && printf '%s/%s\n' "$(pwd -P)" "$(basename "$1")")
    fi
}

# Stable, collision-free key for a game: sanitized name plus a hash of its
# full path, so two different setup.exe files never share a prefix.
game_key()
{
    G_NAME="$(basename "$1")"
    G_NAME="${G_NAME%.*}"
    G_SAFE="$(printf '%s' "$G_NAME" | tr -c 'A-Za-z0-9._-' '_')"
    G_HASH="$(printf '%s' "$1" | cksum | cut -d' ' -f1)"
    printf '%s-%s\n' "$G_SAFE" "$G_HASH"
}

conf_get()
{
    if [ -f "$1" ]; then
        sed -n "s/^$2=//p" "$1" | head -n 1
    fi
    return 0
}

# Set KEY=VALUE in a config file; an empty value removes the key.
conf_set()
{
    init_dirs
    C_TMP="$1.tmp"

    if [ -f "$1" ]; then
        grep -v "^$2=" "$1" > "$C_TMP" || true
    else
        : > "$C_TMP"
    fi

    if [ -n "$3" ]; then
        printf '%s=%s\n' "$2" "$3" >> "$C_TMP"
    fi

    mv "$C_TMP" "$1"
}

# Download URL to OUT. Sends GITHUB_TOKEN only to the GitHub API.
fetch_url()
{
    case "$1" in
        https://api.github.com/*)
            if [ -n "${GITHUB_TOKEN:-}" ]; then
                AUTH="Authorization: Bearer $GITHUB_TOKEN"
            else
                AUTH="Accept: application/vnd.github+json"
            fi
            ;;
        *)
            AUTH="Accept: */*"
            ;;
    esac

    if ! curl \
        --fail \
        --location \
        --show-error \
        --silent \
        --retry 3 \
        --connect-timeout 15 \
        --header "$AUTH" \
        --output "$2" \
        "$1"
    then
        rm -f "$2"
        return 1
    fi

    return 0
}

# Print the tag_name of a GitHub release JSON file.
release_tag()
{
    sed -n \
        's/.*"tag_name":[[:space:]]*"\([^"]*\)".*/\1/p' \
        "$1" |
    head -n 1 || true
}

# Print the first download URL of a release JSON file matching a regex.
release_asset()
{
    grep -o '"browser_download_url":[[:space:]]*"[^"]*"' "$1" |
    sed 's/.*"\(http[^"]*\)"$/\1/' |
    grep -Ei "$2" |
    head -n 1 || true
}

install_ge()
{
    require curl
    require tar
    require gzip
    require file
    require sha512sum
    require basename
    require sed
    require grep
    require head

    init_dirs

    ARCH_NAME="$(detect_arch)"
    SOURCE="${1:-auto}"
    CUSTOM=0

    echo ""
    echo "======================================"
    echo " Proton-CLI Runtime Installer"
    echo "======================================"
    echo ""
    echo "[+] Architecture : $ARCH_NAME"

    URL=""
    TAG=""
    JSON=""

    if [ -n "${PROTON_RUNTIME_URL:-}" ]; then
        URL="$PROTON_RUNTIME_URL"
        TAG="custom"
        CUSTOM=1

        echo "[+] Using PROTON_RUNTIME_URL:"
        echo "    $URL"
        echo ""
    else
        if [ "$SOURCE" = "auto" ]; then
            if [ "$ARCH_NAME" = "aarch64" ]; then
                SOURCE="droiddeck"
            else
                SOURCE="ge"
            fi
        fi

        case "$SOURCE" in
            ge)
                if [ "$ARCH_NAME" = "aarch64" ]; then
                    die "GE-Proton has no aarch64 build. Use: proton-cli install droiddeck"
                fi
                ;;
            droiddeck)
                if [ "$ARCH_NAME" != "aarch64" ]; then
                    die "DroidDeck-Proton is aarch64 only. Use: proton-cli install ge"
                fi
                ;;
            *)
                die "Unknown source: $SOURCE (use auto, ge or droiddeck)"
                ;;
        esac

        echo "[+] Source       : $SOURCE"
        echo "[+] Contacting GitHub..."

        if [ "$SOURCE" = "droiddeck" ]; then
            API="$DD_API"
            JSON="$CACHE/droiddeck.json"
        else
            API="$GE_API"
            JSON="$CACHE/ge-proton.json"
        fi

        if ! fetch_url "$API" "$JSON"; then
            die "Unable to contact GitHub ($API)."
        fi

        if [ ! -s "$JSON" ]; then
            rm -f "$JSON"
            die "GitHub returned an empty response."
        fi

        TAG="$(release_tag "$JSON")"

        if [ -z "$TAG" ]; then
            die "Unable to read the latest release tag from $SOURCE."
        fi

        if [ "$SOURCE" = "droiddeck" ]; then
            URL="$(release_asset "$JSON" 'aarch64\.tar\.gz$')"
        else
            URL="$(release_asset "$JSON" 'GE-Proton.*(x86_64|amd64).*\.tar\.gz$')"
        fi

        if [ -z "$URL" ]; then
            die "No $SOURCE archive for $ARCH_NAME in release $TAG."
        fi

        echo "[+] Latest version : $TAG"
        echo ""
    fi

    FILE="$(basename "$URL")"
    NAME="${FILE%.tar.gz}"

    ARCHIVE="$CACHE/$FILE"
    DEST="$RUNTIMES/$NAME"

    echo "[+] Archive     : $FILE"
    echo "[+] Destination : $DEST"
    echo ""

    case "$ARCH_NAME:$FILE" in
        x86_64:*aarch64*|x86_64:*arm64*)
            die "An ARM archive was selected for x86_64."
            ;;
        aarch64:*x86_64*|aarch64:*amd64*)
            die "An x86_64 archive was selected for aarch64."
            ;;
    esac

    if [ "$CUSTOM" -eq 0 ] && [ -f "$DEST/proton" ] && [ "$(tag_of "$DEST")" = "$TAG" ]; then
        ok_msg="already installed"
        set_default_runtime "$NAME"
        echo "[OK] $NAME is $ok_msg and is now the default runtime."
        echo ""
        return 0
    fi

    if [ -f "$ARCHIVE" ] && [ -s "$ARCHIVE" ]; then
        echo "[+] Archive already downloaded."
    else
        echo "[+] Downloading..."
        echo ""

        if ! fetch_url "$URL" "$ARCHIVE"; then
            die "Download failed."
        fi
    fi

    if [ ! -s "$ARCHIVE" ]; then
        rm -f "$ARCHIVE"
        die "Downloaded archive is empty."
    fi

    # Checksum: the release's <name>.sha512sum, or <url>.sha512sum for a
    # custom archive (optional there).
    if [ "$CUSTOM" -eq 0 ]; then
        SHA_URL="$(release_asset "$JSON" "/${NAME}\.sha512sum\$")"
    else
        SHA_URL="$URL.sha512sum"
    fi

    if [ -n "$SHA_URL" ] && fetch_url "$SHA_URL" "$ARCHIVE.sha512sum"; then
        echo "[+] Verifying checksum..."

        if ! (cd "$CACHE" && sha512sum -c "$FILE.sha512sum" >/dev/null 2>&1); then
            rm -f "$ARCHIVE" "$ARCHIVE.sha512sum"
            die "Checksum mismatch. The archive was removed; run install again."
        fi

        echo "[OK] Checksum matches."
    elif [ "$CUSTOM" -eq 0 ]; then
        die "Checksum unavailable for $FILE; refusing to install an unverified archive."
    else
        warn "No checksum available for this archive; it cannot be verified."
    fi

    echo ""
    echo "[+] Verifying archive..."

    if ! tar -tzf "$ARCHIVE" >/dev/null 2>&1; then
        rm -f "$ARCHIVE"
        die "Downloaded archive is invalid."
    fi

    echo "[OK] Archive is valid."
    echo "[+] Extracting..."

    rm -rf "$DEST"
    mkdir -p "$DEST"

    if ! tar -xzf "$ARCHIVE" -C "$DEST" --strip-components=1; then
        rm -rf "$DEST"
        die "Extraction failed."
    fi

    if [ ! -f "$DEST/proton" ]; then
        rm -rf "$DEST"
        die "Proton executable not found."
    fi

    WINE="$DEST/files/bin/wine"

    if [ ! -f "$WINE" ]; then
        rm -rf "$DEST"
        die "Wine executable not found."
    fi

    WINE_INFO="$(file "$WINE")"

    echo "[+] Wine binary:"
    echo "    $WINE_INFO"
    echo ""

    case "$ARCH_NAME" in
        x86_64)
            if ! echo "$WINE_INFO" | grep -qi "x86-64"; then
                rm -rf "$DEST"
                die "Wine binary is not compatible with x86_64."
            fi
            ;;
        aarch64)
            if ! echo "$WINE_INFO" | grep -qi "ARM aarch64"; then
                rm -rf "$DEST"
                die "Wine binary is not compatible with aarch64."
            fi
            ;;
    esac

    echo "[OK] Wine architecture matches $ARCH_NAME."

    chmod +x "$DEST/proton" "$WINE"
    printf '%s\n' "$TAG" > "$DEST/.proton-cli-tag"

    set_default_runtime "$NAME"

    echo ""
    echo "======================================"
    echo "       Proton runtime installed!"
    echo "======================================"
    echo ""
    echo "Version      : $TAG"
    echo "Architecture : $ARCH_NAME"
    echo "Runtime      : $NAME (default)"
    echo "Path         : $DEST"
    echo ""
}

update_ge()
{
    install_ge "${1:-auto}"
}

use_runtime()
{
    NAME="${1:-}"
    check_name "$NAME"

    if [ ! -f "$RUNTIMES/$NAME/proton" ]; then
        die "Runtime not found: $NAME (see: proton-cli list)"
    fi

    set_default_runtime "$NAME"

    echo ""
    echo "[OK] Default runtime: $NAME"
    echo ""
}

remove_runtime()
{
    NAME="${1:-}"

    if [ -z "$NAME" ]; then
        die "Usage: proton-cli remove <runtime>"
    fi

    check_name "$NAME"

    if [ ! -d "$RUNTIMES/$NAME" ]; then
        die "Runtime not found: $NAME"
    fi

    echo ""
    echo "[+] Removing: $NAME"

    rm -rf "${RUNTIMES:?}/${NAME:?}"

    if [ "$(default_runtime_name)" = "$NAME" ]; then
        rm -f "$DEFAULT_FILE"
        echo "[+] It was the default runtime; no default is set now."
    fi

    echo "[OK] Runtime removed."
}

create_prefix()
{
    NAME="${1:-}"

    if [ -z "$NAME" ]; then
        die "Usage: proton-cli prefix <name>"
    fi

    check_name "$NAME"

    PREFIX="$PREFIXES/$NAME"

    if [ -d "$PREFIX" ]; then
        echo "[+] Prefix already exists: $NAME"
        echo "    $PREFIX"
        return 0
    fi

    mkdir -p "$PREFIX/pfx"

    echo ""
    echo "[OK] Prefix created"
    echo "Name : $NAME"
    echo "Path : $PREFIX"
    echo ""
}

require_game()
{
    if [ "$#" -lt 1 ]; then
        die "A game path is required."
    fi

    if [ ! -f "$1" ]; then
        die "File not found: $1"
    fi

    GAME="$(abspath "$1")"
    GAME_KEY="$(game_key "$GAME")"
    GAME_CONF_FILE="$GAME_CONF/$GAME_KEY.conf"
    PREFIX="$PREFIXES/$GAME_KEY"
}

config_cmd()
{
    require_game "${1:-}"
    shift

    ACTION="${1:-show}"

    case "$ACTION" in
        show)
            echo ""
            echo "Game     : $GAME"
            echo "Key      : $GAME_KEY"
            echo "Runtime  : $(conf_get "$GAME_CONF_FILE" runtime || true)"
            echo "Wrapper  : $(conf_get "$GAME_CONF_FILE" wrapper || true)"
            echo "Settings : $GAME_CONF_FILE"
            echo ""
            ;;
        runtime)
            VALUE="${2:-}"
            if [ -z "$VALUE" ] || [ "$VALUE" = "default" ]; then
                conf_set "$GAME_CONF_FILE" runtime ""
                echo "[OK] Runtime for this game: default"
            else
                check_name "$VALUE"
                if [ ! -f "$RUNTIMES/$VALUE/proton" ]; then
                    die "Runtime not found: $VALUE (see: proton-cli list)"
                fi
                conf_set "$GAME_CONF_FILE" runtime "$VALUE"
                echo "[OK] Runtime for this game: $VALUE"
            fi
            ;;
        wrapper)
            VALUE="${2:-}"
            if [ -z "$VALUE" ] || [ "$VALUE" = "none" ]; then
                conf_set "$GAME_CONF_FILE" wrapper ""
                echo "[OK] Wrapper for this game: none"
            else
                conf_set "$GAME_CONF_FILE" wrapper "$VALUE"
                echo "[OK] Wrapper for this game: $VALUE"
            fi
            ;;
        *)
            die "Usage: proton-cli config <game.exe> show|runtime <name>|wrapper <cmd>"
            ;;
    esac
}

reset_prefix()
{
    require_game "${1:-}"
    shift

    if [ "${1:-}" != "--yes" ]; then
        printf 'Delete the prefix of %s? [y/N] ' "$GAME"
        ANSWER=""
        read -r ANSWER || true
        case "$ANSWER" in
            y|Y|yes|YES)
                ;;
            *)
                echo "Aborted."
                return 0
                ;;
        esac
    fi

    if [ -d "$PREFIX" ]; then
        rm -rf "$PREFIX"
        echo "[OK] Prefix removed: $PREFIX"
    else
        echo "[+] No prefix to remove for $GAME"
    fi
}

winetricks_cmd()
{
    require_game "${1:-}"
    shift

    require winetricks

    if [ "$#" -lt 1 ]; then
        die "Usage: proton-cli winetricks <game.exe> <verb>..."
    fi

    RUNTIME="$(resolve_runtime "$(conf_get "$GAME_CONF_FILE" runtime || true)")"

    mkdir -p "$PREFIX/pfx"

    WINE="$RUNTIME/files/bin/wine"
    if [ ! -x "$WINE" ]; then
        die "Wine binary not found in runtime: $WINE"
    fi

    export WINE
    export WINEPREFIX="$PREFIX/pfx"
    if [ -x "$RUNTIME/files/bin/wineserver" ]; then
        export WINESERVER="$RUNTIME/files/bin/wineserver"
    fi

    echo "[+] winetricks $* (prefix: $PREFIX/pfx)"
    winetricks "$@"
}

run_game()
{
    require tee

    require_game "$@"
    shift

    RUNTIME="$(resolve_runtime "$(conf_get "$GAME_CONF_FILE" runtime || true)")"

    WRAPPER="$(conf_get "$GAME_CONF_FILE" wrapper || true)"
    if [ -z "$WRAPPER" ]; then
        WRAPPER="${PROTON_WRAPPER:-}"
    fi

    if [ "$(detect_arch)" = "aarch64" ] && [ -z "$WRAPPER" ]; then
        case "$(basename "$RUNTIME")" in
            *x86_64*|*x64*|*amd64*)
                warn "x86_64 runtime on aarch64 without a wrapper: it will likely fail."
                echo ""
                ;;
        esac
    fi

    mkdir -p "$PREFIX/pfx" "$LOGS"

    export STEAM_COMPAT_DATA_PATH="$PREFIX"
    export STEAM_COMPAT_CLIENT_INSTALL_PATH="$BASE"
    export WINEPREFIX="$PREFIX/pfx"

    LOG="$LOGS/$GAME_KEY.log"
    STATUS_FILE="$LOG.status"

    echo ""
    echo "======================================"
    echo " Proton-CLI"
    echo "======================================"
    echo ""
    echo "Runtime : $(basename "$RUNTIME")"
    echo "Game    : $GAME"
    echo "Prefix  : $PREFIX"
    echo "Log     : $LOG"
    echo ""

    cd "$(dirname "$GAME")"

    # Output is shown live and copied to the log. The exit status is written
    # to a file because it is not available from the pipeline itself.
    set +e
    (
        set +e
        # shellcheck disable=SC2086
        $WRAPPER "$RUNTIME/proton" run "$GAME" "$@"
        echo $? > "$STATUS_FILE"
    ) 2>&1 | tee "$LOG"
    set -e

    STATUS="$(cat "$STATUS_FILE" 2>/dev/null || echo 1)"
    rm -f "$STATUS_FILE"

    echo ""

    if [ "$STATUS" -eq 0 ]; then
        echo "[OK] Program finished successfully."
    else
        echo "[ERROR] Proton exited with status $STATUS."
        echo "[+] Full log: $LOG"
        return "$STATUS"
    fi
}

list_all()
{
    init_dirs

    DEFAULT_NAME="$(default_runtime_name)"

    echo ""
    echo "======================================"
    echo " Proton-CLI"
    echo "======================================"
    echo ""
    echo "Data: $BASE"
    echo ""

    echo "Runtimes:"
    echo ""

    FOUND=0

    for runtime in "$RUNTIMES"/*
    do
        if [ -f "$runtime/proton" ]; then
            RNAME="$(basename "$runtime")"
            MARK=""
            if [ "$RNAME" = "$DEFAULT_NAME" ]; then
                MARK=" (default)"
            fi
            echo "  [OK] $RNAME$MARK"
            FOUND=1
        fi
    done

    if [ "$FOUND" -eq 0 ]; then
        echo "  No runtime installed"
    fi

    echo ""
    echo "Prefixes:"
    echo ""

    FOUND=0

    for prefix in "$PREFIXES"/*
    do
        if [ -d "$prefix" ]; then
            echo "  [OK] $(basename "$prefix")"
            FOUND=1
        fi
    done

    if [ "$FOUND" -eq 0 ]; then
        echo "  No prefixes"
    fi

    echo ""
}

doctor()
{
    init_dirs

    ARCH_NAME="$(detect_arch)"

    echo ""
    echo "======================================"
    echo " Proton-CLI Doctor"
    echo "======================================"
    echo ""

    echo "Version      : $VERSION"
    echo "User         : $REAL_USER"
    echo "HOME         : $REAL_HOME"
    echo "Architecture : $ARCH_NAME"
    echo ""

    echo "Directories:"
    echo ""
    echo "  Data     : $BASE"
    echo "  Config   : $CONFIG"
    echo "  Cache    : $CACHE"
    echo "  Logs     : $LOGS"
    echo "  Prefixes : $PREFIXES"
    echo "  Runtimes : $RUNTIMES"

    echo ""
    echo "Commands:"
    echo ""

    for command in curl tar gzip file tee cksum sha512sum winetricks
    do
        if command -v "$command" >/dev/null 2>&1; then
            echo "  [OK] $command"
        else
            echo "  [ABSENT] $command"
        fi
    done

    echo ""
    echo "Runtime:"
    echo ""

    if RUNTIME="$(resolve_runtime "" 2>/dev/null)"; then
        echo "  [OK] $(basename "$RUNTIME")"
    else
        echo "  [ABSENT] No runtime"
    fi

    echo "  Default  : $(default_runtime_name)"

    echo ""
    echo "Settings:"
    echo ""
    echo "  PROTON_RUNTIME_URL : ${PROTON_RUNTIME_URL:-<unset>}"
    echo "  PROTON_WRAPPER     : ${PROTON_WRAPPER:-<unset>}"
    if [ -n "${GITHUB_TOKEN:-}" ]; then
        echo "  GITHUB_TOKEN       : set"
    else
        echo "  GITHUB_TOKEN       : unset"
    fi

    if [ "$ARCH_NAME" = "aarch64" ]; then
        echo ""
        echo "Note: aarch64 host. 'install' uses DroidDeck-Proton by default."
        echo "x86_64 runtimes need PROTON_WRAPPER (FEX-Emu or box64)."
    fi

    echo ""
}

version()
{
    echo "proton-cli $VERSION"
}

uninstall()
{
    if [ "$(id -u)" -ne 0 ]; then
        echo ""
        echo "[+] Administrator privileges are required."
        echo "[+] Restarting with sudo..."
        echo ""

        exec sudo "$0" uninstall
    fi

    echo ""
    echo "======================================"
    echo " Proton-CLI Uninstaller"
    echo "======================================"
    echo ""

    echo "[+] User          : $REAL_USER"
    echo "[+] Data          : $BASE"
    echo "[+] Configuration : $CONFIG"
    echo ""

    echo "[+] Removing Proton-CLI data..."

    rm -rf "$BASE"
    rm -rf "$CONFIG"

    echo "[OK] Data removed."

    echo "[+] Removing command..."

    rm -f "/usr/local/bin/proton-cli"

    echo "[OK] /usr/local/bin/proton-cli removed."

    echo ""
    echo "Steam Proton installations were not removed."
    echo "Your Steam games were not removed."
    echo ""
}

COMMAND="${1:-help}"

case "$COMMAND" in
    install)
        shift
        install_ge "$@"
        ;;

    update)
        shift
        update_ge "$@"
        ;;

    use)
        shift
        use_runtime "$@"
        ;;

    remove)
        shift
        remove_runtime "$@"
        ;;

    run)
        shift
        run_game "$@"
        ;;

    config)
        shift
        config_cmd "$@"
        ;;

    prefix)
        shift
        create_prefix "$@"
        ;;

    reset)
        shift
        reset_prefix "$@"
        ;;

    winetricks)
        shift
        winetricks_cmd "$@"
        ;;

    list)
        list_all
        ;;

    doctor)
        doctor
        ;;

    version|--version|-v)
        version
        ;;

    uninstall)
        uninstall
        ;;

    help|--help|-h)
        usage
        ;;

    *)
        echo "Unknown command: $COMMAND"
        echo ""
        usage
        exit 1
        ;;
esac
